# PostgreSQL (Neon o Vercel Postgres). URL con pool para la aplicación.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# URL directa sin pool para migraciones. Si su proveedor solo ofrece una URL,
# use el mismo valor de DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Auth.js: generar con `openssl rand -base64 32`. AUTH_SECRET es el nombre actual.
AUTH_SECRET="replace-with-a-long-random-secret"
# Alias admitido por Auth.js; opcional si AUTH_SECRET está definido.
# NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# En producción Vercel detecta el host. En local puede usar esta URL.
NEXTAUTH_URL="http://localhost:3000"

# Solo para crear el primer administrador con `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
SEED_ADMIN_NAME="Administrador"

# Integraciones externas: se usan únicamente en el servidor.
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID="UCpRrUdCoKniNe62Vl46ajIQ"
FACEBOOK_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
# Opcional. Key de la Maps Embed API (gratis). Sin ella el mapa usa el modo
# sin key de Google Maps. Va en el HTML del mapa, así que en Google Cloud
# restrínjala al dominio del sitio y a la "Maps Embed API".
GOOGLE_MAPS_API_KEY=""
